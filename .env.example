# Copie para .env na raiz e preencha.
#
# ── Opção 0: MOCK (recomendado para testar UI sem backend) ──
# VITE_USE_MOCKS=true
# (não precisa de Supabase nem Stripe)
# Contas demo: aluno@demo.local / trainer@demo.local / admin@demo.local
# Senha: demo123
#
# ── Opção A: Supabase LOCAL (Docker) ──
# 1. Inicie o Docker Desktop
# 2. npm install && npm run supabase:start
# 3. npm run supabase:status  → copie "API URL" e "anon key" para as duas linhas abaixo
# Exemplo típico:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=<anon key do comando status>
#
# ── Opção B: Supabase na nuvem (staging/dev remoto)

# Ative para desenvolvimento offline com dados mockados
VITE_USE_MOCKS=true

# Supabase — Dashboard → Settings → API (desative VITE_USE_MOCKS para usar)
# VITE_SUPABASE_URL=https://SEU_REF.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe — Dashboard → Developers → API keys (modo Test para staging)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── As variáveis abaixo NÃO vão no frontend; configure no Supabase (Edge Functions secrets)
# SUPABASE_URL=https://SEU_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (do endpoint de webhook do Stripe apontando para stripe-webhook)
# ALLOWED_ORIGIN=https://staging.seu-dominio.com   (URL exata do SPA, sem barra final)

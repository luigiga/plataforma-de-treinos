# Copie para .env na raiz e preencha.
#
# ── Opção 0: MOCK (recomendado para testar UI sem backend) ──
# VITE_USE_MOCKS=true
# Contas demo: aluno@demo.local / trainer@demo.local / admin@demo.local
# Senha: demo123
#
# ── Opção A: Supabase LOCAL ──
# npm run supabase:start && npm run supabase:status
#
# ── Opção B: Supabase Cloud (staging/produção) ──
#
# ── Docker / Hostinger ──
# As variáveis VITE_* são injetadas no BUILD da imagem (não em runtime).
# docker compose build && docker compose up -d
# PORT=80 (host) mapeia para o Nginx do container.

# Ative para desenvolvimento offline com dados mockados
VITE_USE_MOCKS=true

# Porta do host ao rodar docker compose (padrão 80)
# PORT=80

# Supabase — Dashboard → Locations → API (desative VITE_USE_MOCKS para usar)
# VITE_SUPABASE_URL=https://SEU_REF.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe — Dashboard → Developers → API keys (modo Test para staging)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── As variáveis abaixo NÃO vão no frontend/Docker SPA ──
# Configure nos secrets das Edge Functions no Supabase:
# SUPABASE_URL=https://SEU_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# ALLOWED_ORIGIN=https://seu-dominio.com
